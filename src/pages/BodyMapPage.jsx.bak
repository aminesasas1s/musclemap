function BodyArt({ navigate }) {
  return (
    <div className="relative mx-auto w-full max-w-[620px] overflow-hidden rounded-[16px] sm:rounded-[22px] border border-slate-800 bg-slate-950/50 p-2 sm:p-3">
      <img src={bodyImage} alt="Body map" className="w-full -translate-x-5 translate-y-1 rounded-[18px] object-contain" />

      <svg viewBox="0 0 1020 1100" className="pointer-events-none absolute inset-0 h-full w-full ">
        {bodyMapRegions.map((area) => (
          <polygon
            key={`${area.title}-${area.href}-${area.coords}`}
            points={area.coords}
            className="pointer-events-auto cursor-pointer fill-transparent stroke-transparent transition-all duration-150 hover:fill-blue-400/35 hover:stroke-blue-300"
            onClick={() => navigate(`/muscle/${area.route}`)}
            onMouseEnter={(event) => {
              event.currentTarget.setAttribute('fill', 'rgba(59,130,246,0.35)')
              event.currentTarget.setAttribute('stroke', '#60a5fa')
              event.currentTarget.setAttribute('stroke-width', '4')
            }}
            onMouseLeave={(event) => {
              event.currentTarget.setAttribute('fill', 'transparent')
              event.currentTarget.setAttribute('stroke', 'transparent')
              event.currentTarget.setAttribute('stroke-width', '0')
            }}
          />
        ))}
      </svg>
    </div>
  )
}

export default function BodyMapPage() {
  const navigate = useNavigate()

  return (
    <div className="space-y-6">
      <div className="glass rounded-[20px] sm:rounded-[28px] border border-slate-800 bg-slate-950/50 p-4 sm:p-5 md:p-7">
        <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <div>
            <p className="text-[14px] font-semibold uppercase tracking-[0.24em] text-blue-400">Body Map</p>
            <p className="mt-2 text-sm text-slate-400">Click the body image regions to jump to the matching muscle pages.</p>
          </div>
          <button className="rounded-full border border-blue-400/40 bg-slate-900/80 px-4 py-2 text-xs text-blue-200">How it works</button>
        </div>
      </div>

      <div className="rounded-[20px] sm:rounded-[28px] border border-slate-800 bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.15),_transparent_18%),linear-gradient(180deg,_rgba(7,12,29,0.92),_rgba(3,8,24,0.92))] p-3 sm:p-4">
        <BodyArt navigate={navigate} />
      </div>

      <div className="flex items-center gap-2 text-sm text-slate-300">
        <span className="h-2.5 w-2.5 rounded-full bg-blue-500 shadow-[0_0_12px_rgba(59,130,246,0.9)]" />
        <span>Click on any muscle below to see exercises</span>
      </div>

      <div className="grid gap-2 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        {muscles.map((muscle) => (
          <button
            key={muscle}
            onClick={() => navigate(`/muscle/${muscle.toLowerCase().replace(/\s+/g, '-')}`)}
            className="rounded-2xl border border-slate-800 bg-slate-900/60 px-4 py-3 text-left text-sm text-slate-200 transition hover:border-brand hover:bg-brand/10"
          >
            {muscle}
          </button>
        ))}
      </div>
    </div>
  )
}
